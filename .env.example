# Text feedback/chat: DashScope OpenAI-compatible Qwen.
CHAT_API_KEY=your_chat_api_key_here
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.6-flash

# Text-to-speech only: MiniMax.
TTS_PROVIDER=minimax
TTS_API_KEY=your_minimax_tts_api_key_here
TTS_BASE_URL=https://api.minimaxi.com/v1
TTS_MODEL=speech-2.8-hd
TTS_VOICE=Chinese (Mandarin)_Warm_Girl

# Speech-to-text only: DashScope/Qwen realtime.
STT_PROVIDER=qwen
DASHSCOPE_API_KEY=your_dashscope_api_key_here
STT_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
STT_MODEL=qwen3.5-livetranslate-flash-realtime-2026-05-19
STT_TRANSCRIPTION_MODEL=qwen3-asr-flash-realtime
STT_SOURCE_LANGUAGE=en
STT_TARGET_LANGUAGE=zh
OPENAI_API_KEY=your_api_key_here
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Optional handwriting image feedback: Ark/OpenAI-compatible vision.
VISION_API_KEY=your_vision_api_key_here
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
VISION_MODEL=MiniMax-M3
AI_SCORE_TIMEOUT_MS=3500
AI_CHAT_TIMEOUT_MS=30000
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
PORT=5173
